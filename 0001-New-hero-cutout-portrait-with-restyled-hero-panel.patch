From: Tjin <t@example.com>
Date: Tue, 17 Nov 2026 16:58:56 +0000
Subject: [PATCH] New hero: cutout portrait with restyled hero panel

---
 app/globals.css         |  46 ++++++++++++++++++++++++++++++
 app/page.tsx            |  60 ++++++++++++++++++++++------------------
 lib/content.ts          |   2 +-
 public/hero-cutout.webp | Bin 0 -> 78130 bytes
 4 files changed, 80 insertions(+), 28 deletions(-)
 create mode 100644 public/hero-cutout.webp

diff --git a/app/globals.css b/app/globals.css
index 88b6770..f64a34b 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -163,6 +163,52 @@
   transform: translate(-50%, 0);
 }
 
+/* --- Hero --- */
+.hero-panel {
+  background: linear-gradient(135deg, #0b0b0b 0%, #141414 60%, #0b0b0b 100%);
+}
+
+.hero-grid {
+  position: absolute;
+  inset: 0;
+  background-image:
+    linear-gradient(to right, rgb(255 255 255 / 4%) 1px, transparent 1px),
+    linear-gradient(to bottom, rgb(255 255 255 / 4%) 1px, transparent 1px);
+  background-size: 36px 36px;
+  mask-image: radial-gradient(ellipse at 70% 60%, #000 20%, transparent 75%);
+  -webkit-mask-image: radial-gradient(ellipse at 70% 60%, #000 20%, transparent 75%);
+}
+
+.hero-glow {
+  position: absolute;
+  left: 50%;
+  bottom: 8%;
+  width: 82%;
+  aspect-ratio: 1;
+  transform: translateX(-50%);
+  border-radius: 999px;
+  background: radial-gradient(circle, rgb(255 255 255 / 20%) 0%, rgb(255 255 255 / 7%) 45%, transparent 70%);
+  filter: blur(8px);
+}
+
+.hero-portrait-img {
+  filter: drop-shadow(0 18px 40px rgb(0 0 0 / 55%));
+}
+
+.hero-cursor {
+  display: inline-block;
+  width: 0.55em;
+  height: 1em;
+  margin-left: 0.5em;
+  vertical-align: -0.15em;
+  background: var(--color-text-soft);
+  animation: hero-blink 1.1s steps(1) infinite;
+}
+
+@keyframes hero-blink {
+  50% { opacity: 0; }
+}
+
 @media (prefers-reduced-motion: reduce) {
   html {
     scroll-behavior: auto;
diff --git a/app/page.tsx b/app/page.tsx
index d17d53d..e171f75 100644
--- a/app/page.tsx
+++ b/app/page.tsx
@@ -16,17 +16,16 @@ import { Sidebar } from "./components/tree-nav";
 
